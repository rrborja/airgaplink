# Vite exposes only VITE_* variables to browser code.
# The sender UI uses this service only for UUID metadata and acknowledgments.
VITE_SENDER_API_URL=http://localhost:3001
# Optional comma-separated Vite dev-server hostnames for private tunnels.
# SENDER_ALLOWED_HOSTS=example.ts.net

# The receiver UI sends decoded QR buffers to its local receiver service.
VITE_RECEIVER_API_URL=http://localhost:3002

# Sender API
SENDER_API_PORT=3001

# Receiver API
RECEIVER_API_PORT=3002
# URL of the hosted sender API. Receiver API posts only ACK UUID metadata here.
SENDER_API_URL=http://localhost:3001
