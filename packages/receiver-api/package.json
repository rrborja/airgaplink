{
  "name": "receiver-api",
  "version": "1.0.0",
  "description": "Headless API for QR code receiver operations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
